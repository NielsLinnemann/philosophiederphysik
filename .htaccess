Options -MultiViews
RewriteEngine On

# ----------------------------------------------------------------------
# 1. Canonical host + scheme: force HTTPS and strip www
#    (http/https + www/no-www all end up on https://example.com)
# ----------------------------------------------------------------------
# Strip www AND force https in a single redirect
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Force https for the bare (non-www) host
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------------------
# 2. Strip a trailing asterisk  (/anything* -> /anything)
# ----------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+([^\s]*?)\*+[\s?] [NC]
RewriteRule ^(.*?)\*+$ /$1 [R=301,L]

# ----------------------------------------------------------------------
# 3. Remove the .html extension from the visible URL
# ----------------------------------------------------------------------
# /index.html (or /sub/index.html) -> /  (or /sub/)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# /page.html -> /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# ----------------------------------------------------------------------
# 4. Remove trailing slash from non-directory URLs  (/page/ -> /page)
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/+$ /$1 [R=301,L]

# ----------------------------------------------------------------------
# 5. Internally serve the clean URL from the real .html file
# ----------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]